IMAGE_REPOSITORY=docker.io/guoshengkai/wechat-article-bot
IMAGE_TAG=1.1.0
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
SPRING_PROFILES_ACTIVE=dev,docker

MYSQL_DATABASE=wechat-article
MYSQL_URL=jdbc:mysql://mysql:3306/wechat-article?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USERNAME=wechat
MYSQL_PASSWORD=replace-with-a-dev-password
MYSQL_ROOT_PASSWORD=replace-with-a-dev-root-password
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-dev-admin-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_TTL_HOURS=24
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
