SPRING_PROFILES_ACTIVE=prod,docker
ENV.MYSQL_URL=jdbc:mysql://production-mysql.example.com:3306/wechat-article?useSSL=true&serverTimezone=Asia/Shanghai
ENV.MYSQL_USERNAME=replace-with-production-user
ENV.MYSQL_PASSWORD=replace-with-production-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-production-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_TTL_HOURS=12
SERVER_PORT=8081
STORAGE_PATH=/app/data/uploads
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
