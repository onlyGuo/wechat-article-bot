IMAGE_REPOSITORY=docker.io/guoshengkai/wechat-article-bot
IMAGE_TAG=1.1.0
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8081
SPRING_PROFILES_ACTIVE=staging,docker

MYSQL_URL=jdbc:mysql://staging-mysql.example.com:3306/wechat-article?useSSL=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=replace-with-staging-user
MYSQL_PASSWORD=replace-with-staging-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-staging-admin-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_TTL_HOURS=24
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
RESTART_POLICY=unless-stopped
